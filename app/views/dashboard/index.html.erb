<% content_for :page_title, "Dashboard" %>

<div class="mb-6">
  <h2 class="text-2xl font-bold text-slate-900">Dashboard</h2>
  <p class="mt-1 text-sm text-slate-500">5 outlet dengan total net sales terendah.</p>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3">
    <h3 class="text-sm font-semibold text-slate-800">5 Outlet Terlemah</h3>
    <span class="text-xs text-slate-400">Diurutkan dari net sales terkecil</span>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
        <tr>
          <th class="whitespace-nowrap px-5 py-3">#</th>
          <th class="whitespace-nowrap px-5 py-3">Outlet</th>
          <th class="whitespace-nowrap px-5 py-3">Outlet ID</th>
          <th class="whitespace-nowrap px-5 py-3 text-right">Jumlah Invoice</th>
          <th class="whitespace-nowrap px-5 py-3 text-right">Total Net Sales</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-slate-100">
        <% @weakest_outlets.each_with_index do |outlet, index| %>
          <tr class="hover:bg-slate-50">
            <td class="whitespace-nowrap px-5 py-3">
              <span class="grid h-7 w-7 place-items-center rounded-full bg-red-50 text-xs font-semibold text-red-700">
                <%= index + 1 %>
              </span>
            </td>
            <td class="whitespace-nowrap px-5 py-3 font-medium text-slate-900"><%= outlet.outlet_name %></td>
            <td class="whitespace-nowrap px-5 py-3 text-slate-500"><%= outlet.outlet_id %></td>
            <td class="whitespace-nowrap px-5 py-3 text-right text-slate-600"><%= outlet.invoice_count %></td>
            <td class="whitespace-nowrap px-5 py-3 text-right font-semibold text-red-700">
              <%= number_to_currency(outlet.total_net_sales, unit: "Rp ", delimiter: ".", precision: 0) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% summary_text = weakest_outlets_summary_text(@weakest_outlets) %>
<% telegram_url = "https://t.me/share/url?url=#{ERB::Util.url_encode(root_url)}&text=#{ERB::Util.url_encode(summary_text)}" %>

<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" data-controller="summary">
  <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3">
    <h3 class="text-sm font-semibold text-slate-800">Summary</h3>
    <span class="text-xs text-slate-400">Teks siap kirim ke sales manager</span>
  </div>

  <div class="p-5">
    <textarea hidden readonly data-summary-target="source"><%= summary_text %></textarea>
    <p class="whitespace-pre-line rounded-lg bg-slate-50 p-4 text-sm leading-relaxed text-slate-700"><%= summary_text %></p>

    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button"
              data-action="click->summary#copy"
              class="rounded-lg border border-red-700 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">
        <span data-summary-target="copyLabel">Salin teks</span>
      </button>

      <%= link_to "Kirim via Telegram", telegram_url,
            target: "_blank", rel: "noopener",
            class: "rounded-lg bg-[#229ED9] px-4 py-2 text-sm font-semibold text-white hover:bg-[#1c87bb]" %>
    </div>
  </div>
</div>
