<% content_for :page_title, "Region: #{@region.name}" %>

<div class="mb-6">
  <nav class="mb-2 text-sm">
    <%= link_to "Regions", regions_path, class: "text-red-700 hover:underline" %>
    <span class="px-1 text-slate-400">/</span>
    <span class="text-slate-600"><%= @region.name %></span>
  </nav>

  <h2 class="text-2xl font-bold text-slate-900">
    Invoice Region: <%= @region.name %>
    <span class="text-lg font-normal text-slate-400">(<%= @invoices.total_entries %>)</span>
  </h2>
  <p class="mt-1 text-sm text-slate-500">Daftar invoice untuk region ini.</p>
</div>

<%= render "invoices/invoices_table", invoices: @invoices %>
